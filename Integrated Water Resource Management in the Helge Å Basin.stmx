	<isee:number_format_extenders/>
	<default_format/>
	<model_units>
		<unit name="Dimensionless">
			<eqn>1</eqn>
			<alias>dmnl</alias>
			<alias>unitless</alias>
			<alias>fraction</alias>
		</unit>
		<unit name="Cubic Meters">
			<eqn>Meters^3</eqn>
			<alias>cubic meter</alias>
			<alias>cu m</alias>
		</unit>
		<unit name="Meters">
			<eqn/>
			<alias>m</alias>
			<alias>meter</alias>
		</unit>
		<unit name="Millimeters">
			<eqn/>
			<alias>mm</alias>
			<alias>millimeter</alias>
		</unit>
		<unit name="Square Meters">
			<eqn>Meters^2</eqn>
			<alias>sq m</alias>
			<alias>square meter</alias>
		</unit>
		<unit name="Euros">
			<eqn/>
			<alias>€</alias>
			<alias>EUR</alias>
			<alias>euro</alias>
		</unit>
		<unit name="Swedish Kroners">
			<eqn/>
			<alias>SEK</alias>
			<alias>swedish kroner</alias>
		</unit>
		<unit name="Years">
			<eqn/>
			<alias>yr</alias>
			<alias>year</alias>
		</unit>
	</model_units>
	<model>
		<variables>
			<stock name="Lake Volume">
				<eqn>25.5e6</eqn>
				<inflow>Precipitation_Direct</inflow>
				<inflow>Catchment_Runoff</inflow>
				<outflow>Outflow_Discharge</outflow>
				<outflow>City_Pipeline</outflow>
				<outflow>Hydropower_Flow</outflow>
				<outflow>Flood_Pumping</outflow>
				<outflow>Irrigation_Flow</outflow>
				<non_negative/>
				<units>cubic meter</units>
			</stock>
			<flow name="Precipitation Direct">
				<eqn>(Precipitation/1000)*Lake_Area</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Catchment Runoff">
				<eqn>(Effective_Precipitation/1000)*Catchment_Area*RunOff_Coefficient</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Outflow Discharge">
				<eqn>Lake_Volume/K_M</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="City Pipeline">
				<eqn> 20536000</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<aux name="Lake depth">
				<eqn>Lake_Volume</eqn>
				<gf>
					<yscale min="0" max="2"/>
					<xpts>0,0.0085,0.017,0.0255,0.051,0.102,0.1275</xpts>
					<ypts>0,0.5,1,1.5,2,2.5,3</ypts>
				</gf>
				<units>Cubic Meters</units>
			</aux>
			<flow name="Hydropower Flow">
				<eqn>PowerPlant_Required_flow</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<aux name="Hydropower Switch">
				<eqn>1</eqn>
				<units/>
			</aux>
			<aux name="Hydropower Demand">
				<eqn>3*31536000</eqn>
				<units>Cubic Meters/Years</units>
			</aux>
			<aux name="Temperature">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="2"/>
					<xpts>2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050</xpts>
					<ypts>6.914583333,8.0125,7.425,7.141666667,7.441666667,8.025,8.216666667,8.183333333,7.458333333,5.85,7.916666667,7,7.408333333,8.85,8.166666667,8,7.866666667,8.733333333,8.75,9.166666667,6.91,8.01,7.43,7.14,7.44,8.03,8.22,8.18,7.46,5.85,7.61,8.81,8.17,7.86,8.19,8.83,9.04,9,8.2,6.44,8.71,7.7,8.15,9.74,8.98,8.8,8.65,9.61,9.63,10.08</ypts>
				</gf>
				<units>Celsius</units>
			</aux>
			<aux name="Precipitation">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="100"/>
					<xpts>2001,2002,2003,2004,2005,2006,2007,2008,2009,2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050</xpts>
					<ypts>633.1,858.6,648.8,873.6,681.8,850.3,1037.2,836.3,714.5,793.4,779.7,762.8,575.6,873.9,816.9,658.1,1006.6,529.4,960.1,830,633.1,858.6,648.8,873.6,681.8,850.3,1037.2,836.3,714.5,793.4,569.8,772.7,583.9,786.2,613.6,765.3,933.5,752.7,643.1,714.1,701.7,686.5,518,786.5,735.2,592.3,905.9,476.5,864.1,747</ypts>
				</gf>
				<units>Millimeter/year</units>
			</aux>
			<aux name="PET">
				<eqn>300+25*Temperature+0.5*Temperature^3</eqn>
				<units>Millimeter/year</units>
			</aux>
			<aux name="ET">
				<eqn>Precipitation/SQRT(1+(Precipitation/PET)^2)</eqn>
				<units>Millimeter/year</units>
			</aux>
			<aux name="RunOff Coefficient">
				<eqn>0.5</eqn>
				<units>Dimensionless</units>
			</aux>
			<aux name="Catchment Area">
				<eqn>3560.059*10^6</eqn>
				<units>Square Meters</units>
			</aux>
			<aux name="Effective Precipitation">
				<eqn>Precipitation-ET</eqn>
				<units>Millimeter/year</units>
			</aux>
			<aux name="K M">
				<eqn>0.0255</eqn>
				<units>year</units>
			</aux>
			<aux name="Lake Area">
				<eqn>Lake_Volume</eqn>
				<gf>
					<yscale min="0" max="2"/>
					<xpts>0,0.0085,0.017,0.0255,0.051,0.102,0.1275</xpts>
					<ypts>0,15,16,17,22,28,28</ypts>
				</gf>
				<units>square meter</units>
			</aux>
			<aux name="PowerPlant Required flow">
				<eqn>IF (Lake_depth&gt;900) AND (Hydropower_Switch=1) THEN Hydropower_Demand ELSE 0</eqn>
				<units/>
			</aux>
			<flow name="Flood Pumping">
				<eqn> 20536000</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<flow name="Irrigation Flow">
				<eqn>IF(Lake_depth&gt;1.1) AND (irrigation_switch=1) THEN Irrigation_Demand ELSE 0</eqn>
				<non_negative/>
				<units>Cubic Meters/Years</units>
			</flow>
			<aux name="irrigation switch">
				<eqn>1</eqn>
			</aux>
			<aux name="Irrigation Demand">
				<eqn>42.8e6</eqn>
			</aux>
			<aux name="Hydro profits">
				<eqn>3e6</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Actual Hydro Profits">
				<eqn>IF (Lake_depth &gt;0.9) AND (Hydropower_Switch =1) THEN Hydro_profits_converstion ELSE 0</eqn>
				<units>SEK</units>
			</aux>
			<aux name="Irrigation profit">
				<eqn>5e6</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Actual Irrigation Profit">
				<eqn>IF (Lake_depth&gt;1.1) AND (irrigation_switch=1) THEN irrigation_profits_converter ELSE 0</eqn>
				<units>SEK</units>
			</aux>
			<aux name="Actual Tourism Revenue">
				<eqn>IF(Lake_depth &gt;1.1) AND (Lake_depth &lt; 1.8) THEN Tourism_base_revenue ELSE (Tourism_base_revenue/2)</eqn>
				<units>SEK</units>
			</aux>
			<aux name="Tourism base revenue">
				<eqn>10e6</eqn>
				<units>SEK</units>
			</aux>
			<aux name="Hydro profits converstion">
				<eqn>Hydro_profits*11</eqn>
				<units>SEK</units>
			</aux>
			<aux name="irrigation profits converter">
				<eqn>Irrigation_profit*11</eqn>
				<units>SEK</units>
			</aux>
			<aux name="Total Revenue">
				<eqn>Actual_Tourism_Revenue+Actual_Hydro_Profits+Actual_Irrigation_Profit</eqn>
				<units>SEK/year</units>
			</aux>
		</variables>
